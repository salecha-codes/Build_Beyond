{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Offline Crop Health model metadata",
  "type": "object",
  "required": ["schema_version", "model_version", "architecture", "model_file", "model_sha256", "class_count", "embedding_dimension", "input", "outputs", "diagnosis_validated"],
  "properties": {
    "schema_version": {"const": 1},
    "architecture": {"enum": ["MobileNetV4-Conv-Small", "MobileNetV3-Large"]},
    "model_version": {"type": "string", "minLength": 1},
    "model_file": {"const": "crop_model.onnx"},
    "model_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "class_count": {"const": 17},
    "embedding_dimension": {"const": 960},
    "diagnosis_validated": {"type": "boolean"},
    "source_evaluated": {"type": "boolean"},
    "source_thresholds_calibrated": {"type": "boolean"},
    "source_acceptance_qualified": {"type": "boolean"},
    "source_acceptance_enabled": {"type": "boolean"},
    "source_evaluation_file": {"const": "source_evaluation.json"},
    "source_evaluation_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "leaf_gate": {"type": "object", "required": ["enabled", "output_name", "minimum_leaf_probability", "receipt_file", "receipt_sha256"], "properties": {"enabled": {"type": "boolean"}, "output_name": {"const": "leaf_logit"}, "minimum_leaf_probability": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1}, "receipt_file": {"const": "leaf_validation.json"}, "receipt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "input": {"type": "object", "required": ["name", "shape", "layout", "resize", "padding_rgb", "mean", "std"], "properties": {"name": {"const": "image"}, "shape": {"const": [1, 3, 224, 224]}, "layout": {"const": "NCHW"}, "resize": {"const": "letterbox"}}},
    "outputs": {"type": "object", "required": ["logits", "embeddings"]}
  }
}
